-- MINIMIZE & DRAG SYSTEMS
---------------------------------------------------
local minimized = false
local originalSize = main.Size

minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        for _,v in pairs(main:GetChildren()) do
            if v:IsA("GuiObject") and v.Name ~= "KeepVisible" then v.Visible = false end
        end
        TweenService:Create(main, TweenInfo.new(0.2), {Size = UDim2.new(0,260,0,40)}):Play()
        minimize.Text = "+"
    else
        TweenService:Create(main, TweenInfo.new(0.2), {Size = originalSize}):Play()
        for _,v in pairs(main:GetChildren()) do
            if v:IsA("GuiObject") then v.Visible = true end
        end
        minimize.Visible = true
        title.Visible = true
        minimize.Text = "-"
    end
end)

local dragging, dragInput, dragStart, startPos
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

