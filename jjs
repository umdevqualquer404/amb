-- CONFIGS INTERNAS
---------------------------------------------------
local enabled = false
local clickDelay = 0.53

local keyMap = {
    Q = Enum.KeyCode.Q,
    E = Enum.KeyCode.E
}

-- Gerencia a caixa de Delay Livre
local function updateDelay()
    local texto = delayBox.Text:gsub("%s+", "")
    if texto == "" then
        clickDelay = 0.53
    else
        local num = tonumber(texto)
        if num and num >= 0 then
            clickDelay = num
        end
    end
end
delayBox.FocusLost:Connect(updateDelay)

local function desativarCheat()
    enabled = false
    toggle.Text = "OFF"
    toggle.TextColor3 = Color3.fromRGB(255,70,70)
    TweenService:Create(toggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25,25,25)}):Play()
end

toggle.MouseButton1Click:Connect(function()
    enabled = not enabled
    if enabled then
        updateDelay()
        toggle.Text = "ON"
        toggle.TextColor3 = Color3.fromRGB(0,255,120)
        TweenService:Create(toggle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30,40,30)}):Play()
    else
        desativarCheat()
    end
end)

---------------------------------------------------
-- GATILHOS DE ENTRADA HÍBRIDOS (PC & MOBILE)
---------------------------------------------------
local function dispararTecla(keycode)
    pcall(function()
        VIM:SendKeyEvent(true, keycode, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, keycode, false, game)
    end)
end

local function cliqueVirtualFisico(button)
    if not button then return end
    pcall(function()
        -- 1. Dispara via sinais internos do Roblox (Garante funcionamento em alguns scripts)
        firesignal(button.MouseButton1Down)
        firesignal(button.MouseButton1Click)
        firesignal(button.TouchTap)
        button:Activate()
        
        -- 2. Dispara simulando clique físico na posição exata da tela (Essencial para Mobile)
        local x = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
        local y = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2)
        
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)  -- Aperta
        task.wait(0.01)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1) -- Solta
    end)
end

---------------------------------------------------
-- MOTOR ORIGINAL COMPACTADO HÍBRIDO
---------------------------------------------------
task.spawn(function()
    local processados = {}

    while true do
        if clickDelay > 0 then
            task.wait(0.01)
        else
            task.wait()
        end

        if enabled then
            pcall(function()
                local pGui = Player:FindFirstChild("PlayerGui")
                local poli = pGui and pGui:FindFirstChild("Polichinelos")
                local screen = poli and poli:FindFirstChild("Screen")

                if screen and enabled then
                    for _, botao in ipairs(screen:GetChildren()) do
                        if botao:IsA("ImageButton") and botao.Visible and not processados[botao] then
                            if not botao:GetAttribute("Completed") then
                                local label = botao:FindFirstChildWhichIsA("TextLabel")
                                
                                if label and label.Text and label.Text ~= "" then
                                    local textoLetra = tostring(label.Text):upper():gsub("%s+", "")
                                    processados[botao] = true
                                    
                                    -- Roteamento Inteligente: Se for PC e a letra for mapeada (Q ou E), usa teclado.
                                    -- Se for Mobile ou outra tecla, força o Toque Físico/Virtual na tela.
                                    if not UIS.TouchEnabled and keyMap[textoLetra] then
                                        dispararTecla(keyMap[textoLetra])
                                    else
                                        cliqueVirtualFisico(botao)
                                    end
                                    
                                    local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Polichinelos")
                                    if remote then
                                        remote:FireServer("Add", 1)
                                    end

                                    if clickDelay > 0 then
                                        task.wait(clickDelay)
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end)

            if #processados > 15 then
                table.clear(processados)
            end
        end
    end
end)
